    "/api/run": {
      "post": {
        "summary": "Run",
        "description": "Run a bounded simulated goal-completion experiment. Never invokes real hardware.",
        "operationId": "run_simulated_discovery",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "scenario": {
                    "type": "string",
                    "enum": [
                      "advection_diffusion",
                      "ambiguity",
                      "diffusion"
                    ],
                    "default": "diffusion"
                  },
                  "noise": {
                    "type": "number",
                    "maximum": 0.03,
                    "minimum": 0.0,
                    "default": 0
                  },
                  "seed": {
                    "type": "integer",
                    "maximum": 2147483647.0,
                    "minimum": 0.0,
                    "default": 7
                  },
                  "auto_experiment": {
                    "type": "boolean",
                    "default": true
                  }
                },
                "additionalProperties": false,
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/discover": {
      "post": {
        "summary": "Uploaded",
        "description": "Identify PDE terms from observed periodic trajectories and independently validate.",
        "operationId": "discover_pde_from_observations",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "training": {
                    "items": {
                      "properties": {
                        "x": {
                          "items": {
                            "type": "number"
                          },
                          "type": "array",
                          "maxItems": 192,
                          "minItems": 32
                        },
                        "t": {
                          "items": {
                            "type": "number"
                          },
                          "type": "array",
                          "maxItems": 401,
                          "minItems": 16
                        },
                        "u": {
                          "items": {
                            "items": {
                              "type": "number"
                            },
                            "type": "array"
                          },
                          "type": "array"
                        },
                        "boundary": {
                          "type": "string",
                          "enum": [
                            "periodic"
                          ],
                          "default": "periodic"
                        }
                      },
                      "type": "object",
                      "required": [
                        "x",
                        "t",
                        "u"
                      ]
                    },
                    "type": "array",
                    "maxItems": 3,
                    "minItems": 1
                  },
                  "validation": {
                    "properties": {
                      "x": {
                        "items": {
                          "type": "number"
                        },
                        "type": "array",
                        "maxItems": 192,
                        "minItems": 32
                      },
                      "t": {
                        "items": {
                          "type": "number"
                        },
                        "type": "array",
                        "maxItems": 401,
                        "minItems": 16
                      },
                      "u": {
                        "items": {
                          "items": {
                            "type": "number"
                          },
                          "type": "array"
                        },
                        "type": "array"
                      },
                      "boundary": {
                        "type": "string",
                        "enum": [
                          "periodic"
                        ],
                        "default": "periodic"
                      }
                    },
                    "type": "object",
                    "required": [
                      "x",
                      "t",
                      "u"
                    ]
                  }
                },
                "type": "object",
                "required": [
                  "training"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
